# Base URL used to build short URLs (no trailing slash).
SHORTY_BASE_URL=http://localhost:8000

# SQLite file (dev), or a Postgres URL for production.
# Neon (Cloud Run): postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.app/db?sslmode=require
SHORTY_DATABASE_URL=sqlite:///./shorty.db

# Used only for sqlite/dev. On Postgres each instance leases a unique id from the DB.
SHORTY_MACHINE_ID=1

# dev/tests create tables via create_all. Prod sets this false and uses Alembic.
SHORTY_AUTO_CREATE_TABLES=true

# LRU read cache.
SHORTY_CACHE_CAPACITY=10000
SHORTY_CACHE_TTL_SECONDS=300

# Per-IP token-bucket throttling.
SHORTY_RATE_LIMIT_CAPACITY=100.0
SHORTY_RATE_LIMIT_REFILL_PER_SECOND=10.0

# Non-blocking click analytics batching.
SHORTY_ANALYTICS_FLUSH_INTERVAL_SECONDS=5.0
SHORTY_ANALYTICS_BATCH_SIZE=500

# Comma-separated CORS origins for the frontend.
SHORTY_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:8080"]
